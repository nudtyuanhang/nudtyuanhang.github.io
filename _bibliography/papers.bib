@article{gao2025magneto,
  title={Magneto: Load-Balanced Key-Value Service for Write-Intensive Workloads},
  author={Gao, Yuanhang and Chen, Yingwen and Yang, Xiangrui and Zhou, Huan and Tang, Shihua and Xu, Ming},
  journal={IEEE Transactions on Services Computing},
  volume={18},
  number={5},
  pages={2994--3007},
  year={2025},
  doi={10.1109/TSC.2025.3592425},
  publisher={IEEE},
  abbr={TSC},
  preview={magneto.png},
  pdf={Magneto_Load-Balanced_Key-Value_Service_for_Write-Intensive_Workloads.pdf},
  abstract={High-performance key-value storage is critical for cloud applications, but write-intensive and highly skewed workloads can cause load imbalance among storage servers. Magneto introduces an in-switch delayed-write mechanism that absorbs frequent writes to hot items, balances load without a centralized controller, and includes a reliability mechanism for switch transitions and failures. An FPGA-integrated-switch prototype achieves up to 8.4x system throughput over baseline systems and reduces backend-server load to 56 percent of the baseline on a skewed workload with 70 percent reads and 30 percent writes.},
  bibtex_show={true},
  selected={true}
}
